# Copy to .env and load with `uv run --env-file .env ...`. Never commit real secrets.
DATABASE_URL=postgresql+psycopg://conversation:local-dev-only@localhost:55432/conversation
# Optional direct connection for Alembic when DATABASE_URL uses Neon pooling.
DATABASE_URL_UNPOOLED=
STUDY_CONSENT_VERSION=draft-v1
LIVEKIT_URL=wss://...
LIVEKIT_API_KEY=...
LIVEKIT_API_SECRET=...

# Model files must exist on the machine running the backend, outside the repository.
# Whisper path is a directory containing model.bin (small multilingual, not small.en).
TUTOR_WHISPER_PATH=/absolute/path/to/faster-whisper-small
TUTOR_KOKORO_MODEL_PATH=/absolute/path/to/kokoro-v1.0.onnx
TUTOR_KOKORO_VOICES_PATH=/absolute/path/to/voices-v1.0.bin

# Set only after a local/self-hosted OpenAI-compatible Qwen/Qwen3-1.7B server is running.
# For example, if it serves /v1 on port 8000: http://127.0.0.1:8000/v1
TUTOR_LLM_BASE_URL=
# TUTOR_LLM_API_KEY=local

# CPU defaults; GPU trials additionally need CUDA/cuDNN and onnxruntime-gpu.
TUTOR_WHISPER_DEVICE=cpu
TUTOR_WHISPER_COMPUTE_TYPE=int8
TUTOR_KOKORO_EXECUTION_PROVIDER=CPUExecutionProvider

# Research calls fail closed until these policies are explicitly configured.
# Private absolute directory (chmod 700); never serve it over HTTP.
STUDY_EVIDENCE_DIR=
STUDY_RETENTION_DAYS=
# For durable Neon storage, configure a private bucket and AWS_* server credentials.
# STUDY_EVIDENCE_DIR then holds only private temporary capture files.
STUDY_EVIDENCE_BUCKET=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Operator monitor dashboard (/monitor); leave empty to disable. Use a long random value.
MONITOR_TOKEN=

# Warm models once at API startup (1) or skip it (0).
TUTOR_WARMUP=1
