# Template runtime server GPU. Salin ke berkas privat di luar repository (mode 600),
# misalnya /root/.config/ai-conversation/runtime.env, lalu isi nilainya. Jangan commit nilai asli.
# Format baris NAMA=nilai, tanpa tanda kutip dan tanpa `export`.

# --- Database (Neon) ---
# Pooled, untuk API.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST-pooler/neondb?sslmode=require
# Koneksi langsung, untuk Alembic dan pg_dump/pg_restore.
DATABASE_URL_UNPOOLED=postgresql+psycopg://USER:PASSWORD@HOST/neondb?sslmode=require

# --- Studi ---
STUDY_CONSENT_VERSION=draft-v1
# Staging privat (mode 700) di disk container, bukan di network volume.
STUDY_EVIDENCE_DIR=/root/.config/ai-conversation/study-evidence
# Isi hanya setelah retensi disetujui (1-3650 hari).
STUDY_RETENTION_DAYS=
STUDY_EVIDENCE_BUCKET=kaiwa
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- LiveKit (hanya di server) ---
LIVEKIT_URL=wss://PROYEK.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Model tutor (di network volume) ---
TUTOR_WHISPER_PATH=/workspace/ai-conversation/models/faster-whisper-small
TUTOR_KOKORO_MODEL_PATH=/workspace/ai-conversation/models/kokoro-v1.0.onnx
TUTOR_KOKORO_VOICES_PATH=/workspace/ai-conversation/models/voices-v1.0.bin
TUTOR_LLM_BASE_URL=http://127.0.0.1:18001/v1
TUTOR_LLM_API_KEY=

# --- GPU ---
# Interpreter API (default .venv-gpu). launch_api.py mengatur LD_LIBRARY_PATH untuk library CUDA/cuDNN.
CONVERSATION_API_PYTHON=/workspace/ai-conversation/backend/.venv-gpu/bin/python
TUTOR_WHISPER_DEVICE=cuda
TUTOR_WHISPER_COMPUTE_TYPE=float16
TUTOR_KOKORO_EXECUTION_PROVIDER=CUDAExecutionProvider
# Muat awal Kokoro di CPU; adapter lalu memakai CUDA untuk session-nya.
ONNX_PROVIDER=CPUExecutionProvider

# --- Lain-lain ---
LOGURU_LEVEL=INFO
OMP_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2

# Operator monitor dashboard (/monitor); leave empty to disable. Use a long random value.
MONITOR_TOKEN=
